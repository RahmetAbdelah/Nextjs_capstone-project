# Copy this file to .env.local and replace every value before using sign-in.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CUSTOMER_EMAIL=customer@example.test
CUSTOMER_PASSWORD=replace-this-customer-password
CUSTOMER_USER_ID=demo-customer
STAFF_EMAIL=staff@example.test
STAFF_PASSWORD=replace-this-staff-password
STAFF_USER_ID=demo-staff